<style>
:root{
  --bg:#0a0e14; --bg2:#0f1420; --panel:#111826; --border:#1e2a3a;
  --accent:#64ffda; --accent2:#ff6b9d; --text:#c9d6e3; --text-dim:#5f7089; --text-bright:#eef4fb;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth; scroll-padding-top:env(safe-area-inset-top,0px);}
body{background:var(--bg); color:var(--text); font-family:'JetBrains Mono', 'Courier New', monospace; overflow-x:hidden; line-height:1.6;}
::selection{background:var(--accent); color:#0a0e14;}
a{color:var(--accent); text-decoration:none;}
.progress{position:fixed; top:env(safe-area-inset-top,0px); left:0; height:3px; background:linear-gradient(90deg,var(--accent),var(--accent2)); z-index:200; width:0%; transition:width .1s;}

/* Nav */
nav{position:fixed; top:env(safe-area-inset-top,0px); right:0; z-index:150; padding:20px 24px; display:flex; gap:18px; font-size:12px;}
nav a{color:var(--text-dim); letter-spacing:.5px; transition:color .2s;}
nav a.active, nav a:hover{color:var(--accent);}
@media(max-width:640px){ nav{display:none;} }

.dots{position:fixed; right:24px; top:50%; transform:translateY(-50%); z-index:150; display:flex; flex-direction:column; gap:14px;}
.dots span{width:8px; height:8px; border-radius:50%; border:1px solid var(--text-dim); display:block; cursor:pointer; transition:.2s;}
.dots span.active{background:var(--accent); border-color:var(--accent); box-shadow:0 0 8px var(--accent);}
@media(max-width:640px){ .dots{display:none;} }

section{min-height:100vh; padding:100px 8vw 60px; display:flex; flex-direction:column; justify-content:center; position:relative;}
.reveal{opacity:0; transform:translateY(24px); transition:opacity .7s ease, transform .7s ease;}
.reveal.visible{opacity:1; transform:translateY(0);}

/* HERO */
#hero{background:radial-gradient(circle at 20% 20%, #0f2030 0%, var(--bg) 60%); align-items:flex-start;}
.prompt{color:var(--accent); font-size:14px; margin-bottom:10px;}
.prompt .cursor{display:inline-block; width:8px; height:16px; background:var(--accent); animation:blink 1s step-start infinite; vertical-align:middle;}
@keyframes blink{50%{opacity:0;}}
h1.name{font-size:clamp(34px,7vw,72px); color:var(--text-bright); font-weight:800; line-height:1.1;}
h1.name span{color:var(--accent);}
.role-line{font-size:clamp(14px,2.5vw,20px); color:var(--text-dim); margin:14px 0 26px; min-height:28px;}
.role-line #typed{color:var(--accent2); border-right:2px solid var(--accent2);}
.contact-row{display:flex; flex-wrap:wrap; gap:18px; font-size:13px; color:var(--text-dim); margin-bottom:30px;}
.contact-row a{color:var(--text);}
.btn-row{display:flex; gap:14px; flex-wrap:wrap;}
.btn{border:1px solid var(--accent); color:var(--accent); padding:10px 20px; font-size:13px; border-radius:4px; transition:.2s;}
.btn:hover{background:var(--accent); color:#0a0e14;}
.btn.alt{border-color:var(--text-dim); color:var(--text-dim);}
.btn.alt:hover{border-color:var(--accent2); color:var(--accent2); background:transparent;}
.scroll-hint{position:absolute; bottom:30px; left:8vw; font-size:11px; color:var(--text-dim);}

.tag{color:var(--accent); font-size:12px; letter-spacing:2px; text-transform:uppercase;}
h2.title{font-size:clamp(24px,4vw,38px); color:var(--text-bright); margin:8px 0 30px;}

/* panel/card look */
.panel{background:var(--panel); border:1px solid var(--border); border-radius:8px; padding:22px 24px; position:relative;}
.panel::before{content:'● ● ●'; position:absolute; top:10px; left:14px; font-size:9px; color:var(--text-dim); letter-spacing:3px;}
.panel-body{margin-top:16px;}

#about .panel{max-width:720px;}
#about p{font-size:15px;}

/* skills */
.skill-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:18px;}
.skill-cat h3{color:var(--accent2); font-size:13px; letter-spacing:1px; text-transform:uppercase; margin-bottom:12px;}
.badges{display:flex; flex-wrap:wrap; gap:8px;}
.badge{border:1px solid var(--border); background:var(--bg2); color:var(--text); font-size:12px; padding:6px 12px; border-radius:20px; transition:.2s;}
.badge:hover{border-color:var(--accent); color:var(--accent); transform:translateY(-2px);}

/* experience timeline */
.timeline-item{border-left:2px solid var(--border); padding-left:22px; position:relative; max-width:760px;}
.timeline-item::before{content:''; position:absolute; left:-7px; top:4px; width:12px; height:12px; border-radius:50%; background:var(--accent); box-shadow:0 0 10px var(--accent);}
.timeline-item h3{color:var(--text-bright); font-size:18px;}
.timeline-item .meta{color:var(--text-dim); font-size:12px; margin:4px 0 14px;}
.timeline-item ul{padding-left:18px; font-size:14px; color:var(--text);}
.timeline-item li{margin-bottom:8px;}

/* projects */
.proj-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:22px; max-width:1100px;}
.proj-card h3{color:var(--text-bright); font-size:17px; margin-bottom:2px;}
.proj-card .stack{color:var(--accent2); font-size:11px; margin-bottom:10px; display:block;}
