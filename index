<script>
// typing effect
const roles = ["Full-Stack Developer", "React Native • React • TypeScript • .NET", "Building end-to-end, shipping real products"];
const typedEl = document.getElementById('typed');
let ri=0, ci=0, deleting=false;
function type(){
  const word = roles[ri];
  if(!deleting){
    ci++; typedEl.textContent = word.slice(0,ci);
    if(ci===word.length){ deleting=true; setTimeout(type,1400); return; }
  } else {
    ci--; typedEl.textContent = word.slice(0,ci);
    if(ci===0){ deleting=false; ri=(ri+1)%roles.length; }
  }
  setTimeout(type, deleting?35:65);
}
type();

// scroll progress
const progress = document.getElementById('progress');
window.addEventListener('scroll', ()=>{
  const h = document.documentElement;
  const pct = (h.scrollTop)/(h.scrollHeight - h.clientHeight)*100;
  progress.style.width = pct+'%';
});

// reveal on scroll
const io = new IntersectionObserver((entries)=>{
  entries.forEach(e=>{ if(e.isIntersecting) e.target.classList.add('visible'); });
},{threshold:0.15});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

// nav active state + dots
const sections = ['hero','about','skills','experience','projects','contact'];
const dotsWrap = document.getElementById('dots');
sections.forEach((id,i)=>{
  const d = document.createElement('span');
  d.dataset.sec = id;
  d.onclick = ()=>document.getElementById(id).scrollIntoView({behavior:'smooth'});
  dotsWrap.appendChild(d);
});
const navLinks = document.querySelectorAll('nav a');
const dotEls = document.querySelectorAll('.dots span');
const spy = new IntersectionObserver((entries)=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      navLinks.forEach(a=>a.classList.toggle('active', a.dataset.sec===e.target.id));
      dotEls.forEach(d=>d.classList.toggle('active', d.dataset.sec===e.target.id));
    }
  });
},{threshold:0.5});
sections.forEach(id=>spy.observe(document.getElementById(id)));
</script>
